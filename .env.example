# Optional: leave blank to keep using local JSON files.
# Copy this file to .env.local at the project root, then add your Neon URL.
# Keep DATABASE_URL on the server; do not prefix it with NEXT_PUBLIC_.
# NestJS also reads this URL; its project endpoints require Neon configuration.
DATABASE_URL=
# Direct connection for schema setup; Neon CLI pulls both URLs automatically.
# When omitted, db:setup uses DATABASE_URL for backwards compatibility.
DATABASE_URL_UNPOOLED=
